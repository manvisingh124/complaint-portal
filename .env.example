# ==========================================
# BBDU Grievance Portal Environment Settings
# ==========================================

# Django Settings
SECRET_KEY=django-insecure-bbdu-grievance-portal-key-super-secret
DEBUG=True
ALLOWED_HOSTS=*

# Supabase PostgreSQL Database Settings
# Find these in Supabase Dashboard -> Project Settings -> Database -> Connection Info
USE_SUPABASE_DB=False
SUPABASE_DB_HOST=db.xxxxxxxxxxxx.supabase.co
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password
SUPABASE_DB_PORT=5432

# Supabase Project API Keys
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth Credentials
# Configured in Supabase Auth -> Providers -> Google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
